# Alpha-Beta Pruning

values = [2, 4, 1, 10]

def alpha_beta(depth, index, maximizing, alpha, beta):

    if depth == 2:
        return values[index]

    if maximizing:
        best = -999

        for i in range(2):
            val = alpha_beta(depth+1, index*2+i, False, alpha, beta)
            best = max(best, val)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = 999

        for i in range(2):
            val = alpha_beta(depth+1, index*2+i, True, alpha, beta)
            best = min(best, val)
            beta = min(beta, best)

            if beta <= alpha:
                break

        return best


result = alpha_beta(0, 0, True, -999, 999)

print("Optimal Value:", result)






